[Unit]
Description=Check GHCR for a new rc image every 5 minutes

[Timer]
# First check shortly after boot, then every 5 minutes since the last run finished.
OnBootSec=2min
OnUnitActiveSec=5min
# Spread the load and avoid hitting GHCR on the exact minute like everyone else.
RandomizedDelaySec=60
# Catch up on a check missed while the machine was off.
Persistent=true

[Install]
WantedBy=timers.target
