{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `private/` is gitignored real-data input, and may hold reference copies of old
  // scripts that no longer compile against the current schema. Type-checking them
  // breaks `tsc`/`next build` locally while the CI, which never sees the directory,
  // stays green — so the two disagree for no useful reason.
  "exclude": ["node_modules", "private"]
}
