# Copy to .env and fill in. `cp .env.example .env` is the first step in
# docs/dev-environment.md — the file it names did not exist until now.

# The dev database from docker-compose.yml. The test one (port 5433) is read
# from vitest.config.mts, not from here.
DATABASE_URL=postgresql://rc:rc@localhost:5432/releasechronicle

# Session and action-link signing key, and the CI ingestion token.
#
# Both are optional for `npm run dev`, which falls back to a public literal.
# They are NOT optional for the app container: it runs NODE_ENV=production,
# where that literal is refused — a public signing key would let any visitor
# forge an admin session. Compose now refuses to start the app without them.
#
#   openssl rand -base64 32
AUTH_SECRET=
RC_WRITE_TOKEN=

# Local user store (config/auth-users.yml). Set AUTH_PROVIDER=ldap to
# authenticate against the dev directory instead — see config/ldap.yml.
# AUTH_PROVIDER=ldap
# LDAP_URL=ldap://localhost:1389
# LDAP_BASE_DN=dc=example,dc=org
# LDAP_BIND_DN=cn=admin,dc=example,dc=org
# LDAP_BIND_PASSWORD=adminpassword

# Where one-click action links in notifications point.
APP_BASE_URL=http://localhost:3000

# Mailpit, from docker-compose.yml. Nothing leaves the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=releasechronicle@example.org

# Shows a link to the catch-all mailbox on /admin/logs. Development only.
RC_MAILPIT_URL=http://localhost:8025
