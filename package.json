{
  "name": "releasechronicle",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:wipe": "tsx prisma/wipe.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:private": "tsx prisma/seed-private.ts",
    "db:seed:private:config": "tsx prisma/seed-private.ts --config-only",
    "demo:tick": "tsx prisma/demo-tick.ts",
    "demo:reset": "tsx prisma/demo-reset.ts",
    "dev:up": "docker compose up -d db db_test mailpit ldap",
    "dev:down": "docker compose stop db db_test mailpit ldap",
    "dev:reset": "prisma migrate deploy && npm run db:seed:demo"
  },
  "prisma": {
    "seed": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.7",
    "ldapts": "^9.0.0",
    "next": "15.5.23",
    "nodemailer": "^9.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "22.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "19.0.1",
    "dotenv": "16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prisma": "6.1.0",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    },
    "tsx": {
      "esbuild": "0.27.2"
    }
  }
}
