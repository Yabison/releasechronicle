# Copy to .env.demo on the server (chmod 600) and fill in. Never commit .env.demo.
#   cp .env.demo.example .env.demo

# Public hostname. Must already point (A/AAAA) at the server.
DEMO_DOMAIN=demo.example.org

# Le mot de passe de la base part tel quel dans DATABASE_URL, donc il ne doit
# contenir aucun caractère réservé d'URL. `base64` produit des « / » : le premier
# coupe l'autorité de l'URL en deux et Prisma échoue sur
#   P1013 ... invalid port number in database URL
# `hex` ne produit que [0-9a-f], jamais besoin d'échapper.
#   openssl rand -hex 32
DEMO_DB_PASSWORD=

# Ceux-là ne sont que des valeurs d'environnement, aucun caractère interdit.
#   openssl rand -base64 32
DEMO_AUTH_SECRET=
DEMO_WRITE_TOKEN=

# Image tag to run.
#   rc              = tête de la branche rc, republiée à chaque merge (défaut démo)
#   rc-0.2.0        = le candidat de la 0.2.0, figé
#   release-0.2.0   = la release 0.2.0
#   latest          = la dernière release
#   0.2.0           = la même, sans préfixe
# Le timer systemd suit ce tag : sur `rc` la démo se met à jour toute seule, sur une
# version figée elle ne bouge plus.
RC_IMAGE_TAG=rc

# Seconds between two ticks of the demo world.
DEMO_TICK_SECONDS=180

# Traefik wiring — match the running proxy. Locally the dev stack uses the network
# traefik_webgateway_dev and the entrypoint websecure.
TRAEFIK_NETWORK=traefik_webgateway
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
